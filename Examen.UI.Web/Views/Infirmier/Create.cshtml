@model Examen.ApplicationCore.Domain.Infirmier

@{
    ViewData["Title"] = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Create</h1>

<h4>Infirmier</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="InfirmierId" class="control-label"></label>
                <input asp-for="InfirmierId" class="form-control" />
                <span asp-validation-for="InfirmierId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="NomComplet" class="control-label"></label>
                <input asp-for="NomComplet" class="form-control" />
                <span asp-validation-for="NomComplet" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Specialite" class="control-label"></label>
                <select asp-for="Specialite" class="form-control"
                        asp-items="ViewBag.Specialites">
                    <option value="">-- Sélectionner une spécialité --</option>
                </select>
                <span asp-validation-for="Specialite" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LaboratoireFk" class="control-label"></label>
                <select asp-for="LaboratoireFk" class="form-control"
                        asp-items="ViewBag.Laboratoires">
                    <option value="">-- Sélectionner un laboratoire --</option>
                </select>
                <span asp-validation-for="LaboratoireFk" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
