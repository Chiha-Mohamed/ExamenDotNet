@model IEnumerable<Examen.ApplicationCore.Domain.Infirmier>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Liste des Infirmiers</h1>

<p>
    <a asp-action="Create">Créer un nouvel Infirmier</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.First().InfirmierId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().NomComplet)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.First().Specialite)
            </th>
            <th>
                Laboratoire
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.InfirmierId)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NomComplet)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Specialite)
                </td>
                <td>
                    @item.Laboratoire?.Intitule
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.InfirmierId }) |
                    @Html.ActionLink("Details", "Details", new { id = item.InfirmierId }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.InfirmierId })
                </td>
            </tr>
        }
    </tbody>
</table>
